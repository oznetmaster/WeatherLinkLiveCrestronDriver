<Project>
  <PropertyGroup><DriverManifestFile Condition="'$(DriverManifestFile)' == ''">$(MSBuildThisFileDirectory)WeatherlinkLiveCrestronDriver.json</DriverManifestFile></PropertyGroup>
  <Import Project="../build/shared/driver-versioning/DriverVersion.props" />
  <PropertyGroup><DriverReleaseVersion Condition="'$(DriverReleaseVersion)' == ''">$([System.Version]::Parse('$(DriverManifestVersion)').ToString(3))</DriverReleaseVersion></PropertyGroup>
</Project>
